# Frontend API path.
# Local development uses the Vite /api proxy.
VITE_API_BASE_URL=/api

# Development proxy destination.
VITE_DEV_API_PROXY_TARGET=https://casemesh-api-dev.lemonwater-0bb11448.uaenorth.azurecontainerapps.io

# Microsoft Entra ID configuration.
# These identifiers are not secrets.
VITE_ENTRA_TENANT_ID=<your-tenant-id>
VITE_ENTRA_CLIENT_ID=<casemesh-web-client-id>
VITE_ENTRA_API_CLIENT_ID=<casemesh-api-client-id>