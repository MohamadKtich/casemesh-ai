# Logs
*.log
logs/

# Local raw/private data
data/raw/*
!data/raw/.gitkeep

# Synthetic dataset contents may be large; keep the folder scaffold
data/synthetic/casemesh-ai-dataset-v1.0/*
!data/synthetic/casemesh-ai-dataset-v1.0/.gitkeep

# Evaluation files can be added selectively later
data/evaluation/private/

# Azure / Entra temporary request payloads
apps/api/api-scope-body.json
apps/api/api-token-version-body.json
apps/api/spa-body.json

# Local Azure auth configuration backups
apps/web/auth-config-backup.json
apps/web/auth-config-update.json

# Temporary end-to-end validation evidence
azure-evidence-test.txt
frontend-evidence-test.txt
# Generated Bicep ARM template
infrastructure/azure/main.json

# Keep generated synthetic data local but track reproducibility scripts.
!data/synthetic/casemesh-ai-dataset-v1.0/scripts/
!data/synthetic/casemesh-ai-dataset-v1.0/scripts/*.py
data/synthetic/*.zip
data/synthetic/casemesh-ai-dataset-v1.0-generated/
