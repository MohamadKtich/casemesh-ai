# ------------------------------------------------------------
# CaseMesh AI — example configuration only
# Copy to .env locally when implementation begins.
# NEVER commit .env
# ------------------------------------------------------------

APP_NAME=CaseMesh AI
APP_ENV=local
LOG_LEVEL=INFO

API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=3000

# PostgreSQL
POSTGRES_USER=casemesh
POSTGRES_PASSWORD=change_me
POSTGRES_DB=casemesh
DATABASE_URL=postgresql+asyncpg://casemesh:change_me@postgres:5432/casemesh

# MinIO
MINIO_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=casemesh
MINIO_ROOT_PASSWORD=change_me
MINIO_BUCKET=evidence

# AI
AI_MODE=local
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:8b

# Azure (leave blank until cloud validation)
AZURE_AI_ENDPOINT=
AZURE_AI_API_KEY=
AZURE_STORAGE_CONNECTION_STRING=

# AWS (prefer identity-based auth; do not paste long-lived keys here)
AWS_REGION=
AWS_BEDROCK_MODEL_ID=

# GCP — optional
GCP_PROJECT_ID=
GCP_LOCATION=

# Safety / cost guardrails
MAX_LLM_CALLS_PER_CASE=20
MAX_TOKENS_PER_CASE=50000
MAX_ESTIMATED_COST_PER_CASE_USD=0.50
