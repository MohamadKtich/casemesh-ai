# ------------------------------------------------------------
# CaseMesh AI - example configuration only
# Copy to .env for local development.
# NEVER commit .env
# ------------------------------------------------------------

APP_NAME=CaseMesh AI
APP_ENV=local
LOG_LEVEL=INFO

API_PORT=8000
WEB_PORT=3000

# PostgreSQL
POSTGRES_USER=casemesh
POSTGRES_PASSWORD=change_me
POSTGRES_DB=casemesh
POSTGRES_PORT=5432

# Local application database URL.
# Docker Compose overrides this so the API connects to `postgres`.
DATABASE_URL=postgresql+asyncpg://casemesh:change_me@localhost:5432/casemesh

# Document storage
DOCUMENT_STORAGE_ROOT=data/raw

# Local AI
EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768

GENERATION_PROVIDER=ollama
GENERATION_MODEL=qwen3:8b
GENERATION_TEMPERATURE=0.1
GENERATION_MAX_TOKENS=700

# Azure - leave blank until cloud validation
AZURE_AI_ENDPOINT=
AZURE_AI_API_KEY=
AZURE_STORAGE_CONNECTION_STRING=

# AWS - prefer identity-based authentication
AWS_REGION=
AWS_BEDROCK_MODEL_ID=

# GCP - optional
GCP_PROJECT_ID=
GCP_LOCATION=

# Safety / cost guardrails
MAX_LLM_CALLS_PER_CASE=20
MAX_TOKENS_PER_CASE=50000
MAX_ESTIMATED_COST_PER_CASE_USD=0.50

# Controlled action execution
# Live execution must remain disabled unless explicitly enabled.
ACTION_EXECUTION_ENABLED=false
ACTION_EXECUTION_MODE=dry_run

# Live action allowlist
# Only low-impact internal actions should be enabled here.
ACTION_EXECUTION_LIVE_ALLOWLIST=update_case_status

# MCP Streamable HTTP
# Hostname only. Do not include https:// or /mcp.
# Leave blank for local development.
MCP_PUBLIC_HOSTNAME=

# MCP authentication
# Never place a real production token in this example file.
# Store the real cloud value in Azure Container Apps Secrets.
MCP_AUTH_TOKEN=
# Investigation agent MCP integration
# Keep false until the MCP client path has been validated.
INVESTIGATION_USE_MCP=false

# Internal MCP URL used by the investigation workflow.
# In Azure the agent can use the MCP endpoint inside its own container.
MCP_CLIENT_URL=http://127.0.0.1:8000/mcp/

MCP_CLIENT_TIMEOUT_SECONDS=120